{
	"name": "torntools-extension",
	"version": "9.2.4",
	"type": "module",
	"scripts": {
		"types": "tsc --noEmit --pretty",
		"types:watch": "tsc --noEmit --watch --pretty",
		"dev:chrome": "concurrently --names TSC,WXT \"bun run types:watch\" \"wxt\"",
		"dev:firefox": "concurrently --names TSC,WXT \"bun run types:watch\" \"wxt -b firefox --mv3\"",
		"build": "tsc && bun run build:chrome && bun run build:firefox",
		"build:chrome": "wxt build",
		"build:firefox": "wxt build -b firefox --mv3",
		"build:userscripts": "bun tools/build-userscripts.ts",
		"build:production": "APPEND_COMMIT_HASH=false bun run build",
		"zip": "bun run zip:chrome && bun run zip:firefox",
		"zip:chrome": "wxt zip",
		"zip:firefox": "wxt zip -b firefox --mv3",
		"postinstall": "wxt prepare",
		"test": "bun test",
		"test:watch": "bun test --watch",
		"format": "oxfmt --check",
		"format:fix": "oxfmt",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"check:fix": "oxlint --fix && oxfmt",
		"static-items": "bun tools/update-static-items.ts",
		"docs:dev": "astro dev --root docs",
		"docs:build": "astro build --root docs",
		"docs:preview": "astro preview --root docs"
	},
	"dependencies": {
		"@phosphor-icons/core": "^2.1.1",
		"@phosphor-icons/web": "^2.1.2",
		"@tailwindcss/vite": "^4.3.3",
		"@tanstack/svelte-table": "^9.2.4",
		"@webext-core/proxy-service": "^3.0.2",
		"@wxt-dev/module-svelte": "^2.0.5",
		"chart.js": "^4.5.1",
		"sortablejs": "^1.15.7",
		"source-map": "^0.8.0",
		"svelte-spa-router": "^5.1.1",
		"tailwindcss": "^4.3.3"
	},
	"devDependencies": {
		"@astrojs/mdx": "^8.0.0",
		"@astrojs/starlight": "^0.41.11",
		"@astrojs/svelte": "^9.0.1",
		"@fontsource-variable/geist": "^5.3.0",
		"@types/bun": "^1.4.0",
		"@types/sortablejs": "^1.15.9",
		"@wxt-dev/auto-icons": "^1.1.2",
		"astro": "^7.2.10",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"concurrently": "^10.0.5",
		"drag-drop-touch": "^1.3.1",
		"mode-watcher": "^1.1.0",
		"oxfmt": "^0.66.0",
		"oxlint": "^1.81.0",
		"oxlint-tsgolint": "^7.0.2001",
		"phosphor-svelte": "^3.1.0",
		"shadcn-svelte": "^1.6.0",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tornapi-typescript": "^6.13.1",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"user-agent-data-types": "^0.4.3",
		"vite": "^8.2.2",
		"vite-plugin-monkey": "^8.1.1",
		"wxt": "^0.21.4"
	}
}
